-- In-game Lua is LuaJIT (5.1 + bit, ffi) and so is the test runner.
std = 'luajit'
max_line_length = false

-- Ashita v4 injects these into the game client.
read_globals = { 'AshitaCore', 'ashita' }
globals = { 'addon' }

-- Generated by /sk3 dump.
exclude_files = { 'tests/data/**' }

-- The runner defines the helpers every *_test.lua uses.
files['tests/run.lua'] = { allow_defined_top = true }
files['tests/*_test.lua'] = { read_globals = { 'test', 'eq' } }
